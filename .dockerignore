# Secrets never go into the image
**/.env
**/.env.*
!**/.env.example
!frontend/.env.development
!frontend/.env.production

.git
.gitignore
**/.venv/
**/__pycache__/
**/*.pyc
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
**/node_modules/
.DS_Store
PLAN.md
Profile.pdf

# Built in the image, never copied in
frontend/dist/

# End-to-end tests run outside the image
frontend/e2e/
frontend/playwright.config.ts
frontend/test-results/
frontend/playwright-report/
